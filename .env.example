# Copy these into your host's environment-variable settings
# (Render dashboard, Railway dashboard, or `export VAR=value` in a shell).
# The app does NOT auto-load a .env file — set the variables in the environment.

PORT=3000
AZUTVA_SECRET=replace-with-a-long-random-string
AZUTVA_ADMIN_EMAIL=admin@azutva.com
AZUTVA_ADMIN_PASSWORD=change-this-password
AZUTVA_DATA_DIR=./data
AZUTVA_UPLOAD_DIR=./uploads
